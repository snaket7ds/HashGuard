<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>HashGuard.App</RootNamespace>
    <AssemblyName>HashGuard</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\HashGuard.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged and self-contained: no MSIX, no separate Windows App SDK runtime install. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Program.cs has its own Main, so a second launch can hand over to the running copy first. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <!-- Release publish: one HashGuard.exe, like v1, so v1's updater can install it. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Windows App SDK 2.x embeds resources.pri into the single file; it needs the MSIX tooling targets for that (no MSIX is produced). -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- No ReadyToRun: it recompiles .NET's own System.Private.CoreLib.dll, which then loses
         Microsoft's signature, and Windows Security quarantines that unsigned copy as
         Trojan:Win32/Bearfoos.B!ml. Without it the runtime files stay Microsoft-signed (~70 ms slower start). -->
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
    <EmbeddedResource Include="Assets\HashGuard.ico" LogicalName="HashGuard.ico" />
    <Content Include="Assets\HashGuard.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.7.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HashGuard.Core\HashGuard.Core.csproj" />
  </ItemGroup>
</Project>
