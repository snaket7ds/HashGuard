<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HashGuard.App.Pages.ActivityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:HashGuard.App.ViewModels"
    xmlns:local="using:HashGuard.App.Pages"
    NavigationCacheMode="Required">

    <Page.Resources>
        <DataTemplate x:Key="DayTemplate" x:DataType="vm:ActivityDayHeader">
            <TextBlock Text="{x:Bind Text}" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="4,14,0,6"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.HeadingLevel="Level2" />
        </DataTemplate>

        <DataTemplate x:Key="EntryTemplate" x:DataType="vm:ActivityItemViewModel">
            <Border Style="{StaticResource CardStyle}" Padding="16,12" Margin="0,0,0,6">
                <Grid ColumnSpacing="14" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Width="32" Height="32" CornerRadius="8" VerticalAlignment="Top" Background="{x:Bind local:ActivityPage.KindTint(Kind, IsSummary)}">
                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="15" Foreground="{x:Bind local:ActivityPage.KindText(Kind, IsSummary)}" />
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                            <Border Style="{StaticResource ChipStyle}" Padding="8,1" Background="{x:Bind local:ActivityPage.KindTint(Kind, IsSummary)}">
                                <TextBlock Text="{x:Bind Pill}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{x:Bind local:ActivityPage.KindText(Kind, IsSummary)}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind TimeText}" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" Margin="0,0,6,0"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <Button Content="{x:Bind FoldText, Mode=OneWay}" Tag="{x:Bind Self}" Click="Fold_Click" Visibility="{x:Bind CanFold}" />
                        <ToggleButton Content="Details" IsChecked="{x:Bind IsExpanded, Mode=TwoWay}" Visibility="{x:Bind HasDetails}" />
                    </StackPanel>

                    <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ColumnSpacing="12" Visibility="{x:Bind IsExpanded, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind DetailText}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <Button Grid.Column="1" VerticalAlignment="Top" Tag="{x:Bind Self}" Click="ShowInFolder_Click" Visibility="{x:Bind CanShowInFolder}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE838;" FontSize="14" />
                                <TextBlock Text="Show in folder" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <local:ActivityTemplateSelector x:Key="RowTemplates" DayTemplate="{StaticResource DayTemplate}" EntryTemplate="{StaticResource EntryTemplate}" />
    </Page.Resources>

    <Grid MaxWidth="1040" Padding="32,4,32,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Activity" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <AutoSuggestBox Grid.Column="1" Width="260" PlaceholderText="Search files, apps or hashes" QueryIcon="Find"
                            TextChanged="Search_TextChanged" VerticalAlignment="Center" AutomationProperties.Name="Search activity" />
            <Button Grid.Column="2" Click="OpenLogs_Click" VerticalAlignment="Center" AutomationProperties.Name="Open logs folder">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE838;" FontSize="14" />
                    <TextBlock Text="Open logs" />
                </StackPanel>
            </Button>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4">
            <SelectorBar x:Name="Filters" SelectionChanged="Filters_SelectionChanged">
                <SelectorBarItem Text="All" Tag="All" IsSelected="True" />
                <SelectorBarItem Text="Needs action" Tag="NeedsAction" />
                <SelectorBarItem Text="Unknown" Tag="Unknown" />
                <SelectorBarItem Text="Quarantine and firewall" Tag="Actions" />
            </SelectorBar>
            <Border Style="{StaticResource ChipStyle}" VerticalAlignment="Center" Background="{ThemeResource AttentionTintBrush}"
                    Visibility="{x:Bind local:ActivityPage.HasText(ViewModel.NeedsActionCount), Mode=OneWay}"
                    ToolTipService.ToolTip="Checks that still need action">
                <TextBlock Text="{x:Bind ViewModel.NeedsActionCount, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold"
                           Foreground="{ThemeResource AttentionTextBrush}" />
            </Border>
        </StackPanel>

        <Grid Grid.Row="2">
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,40,0,0" />

            <Border Style="{StaticResource CardStyle}" VerticalAlignment="Top" Padding="24,20"
                    Visibility="{x:Bind local:ActivityPage.EmptyVisible(ViewModel.IsEmpty, ViewModel.IsLoading), Mode=OneWay}">
                <TextBlock Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="WrapWholeWords" />
            </Border>

            <ListView ItemsSource="{x:Bind ViewModel.Rows}" ItemTemplateSelector="{StaticResource RowTemplates}" SelectionMode="None"
                      IsItemClickEnabled="False" Padding="0,0,0,24" AutomationProperties.Name="Activity history">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
        </Grid>
    </Grid>
</Page>
