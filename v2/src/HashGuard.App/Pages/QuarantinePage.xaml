<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HashGuard.App.Pages.QuarantinePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:HashGuard.App.ViewModels"
    xmlns:local="using:HashGuard.App.Pages">

    <Grid MaxWidth="1040" Padding="32,4,32,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Quarantine" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,4" />

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="24,18">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="36" Height="36" CornerRadius="8" Background="{ThemeResource NeutralTintBrush}" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE72E;" FontSize="16" Foreground="{ThemeResource NeutralTextBrush}" />
                </Border>
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}"
                           TextWrapping="WrapWholeWords" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="Remove missing entries" Click="RemoveMissing_Click" Visibility="{x:Bind ViewModel.HasMissing, Mode=OneWay}" />
                    <Button Click="OpenFolder_Click" AutomationProperties.Name="Open quarantine folder">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE838;" FontSize="14" />
                            <TextBlock Text="Open folder" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.Items}" SelectionMode="None" Padding="0" IsItemClickEnabled="False"
                  Visibility="{x:Bind ViewModel.HasItems, Mode=OneWay}" AutomationProperties.Name="Quarantined files">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,8" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:QuarantineItemViewModel">
                    <Border Style="{StaticResource CardStyle}" Padding="16,14">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Width="36" Height="36" CornerRadius="8" VerticalAlignment="Top" Background="{ThemeResource NeutralTintBrush}">
                                <FontIcon Glyph="&#xE72E;" FontSize="16" Foreground="{ThemeResource NeutralTextBrush}" />
                            </Border>

                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                    <Border Style="{StaticResource ChipStyle}" Padding="8,1" Background="{ThemeResource AttentionTintBrush}"
                                            Visibility="{x:Bind IsMissing}">
                                        <TextBlock Text="File missing" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource AttentionTextBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{x:Bind FromText}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                                <TextBlock Text="{x:Bind InfoText}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <ProgressRing Width="20" Height="20" IsActive="{x:Bind IsBusy, Mode=OneWay}" Visibility="{x:Bind IsBusy, Mode=OneWay}" />
                                <DropDownButton Content="Restore" IsEnabled="{x:Bind CanRestore, Mode=OneWay}">
                                    <DropDownButton.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                            <MenuFlyoutItem Text="Restore to where it was" Tag="{x:Bind Self}" Click="RestoreOriginal_Click">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE777;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Restore to the Desktop" Tag="{x:Bind Self}" Click="RestoreDesktop_Click">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8FC;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </DropDownButton.Flyout>
                                </DropDownButton>
                                <Button Tag="{x:Bind Self}" Click="Delete_Click" IsEnabled="{x:Bind local:QuarantinePage.Not(IsBusy), Mode=OneWay}"
                                        AutomationProperties.Name="Delete permanently" ToolTipService.ToolTip="Delete permanently">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
