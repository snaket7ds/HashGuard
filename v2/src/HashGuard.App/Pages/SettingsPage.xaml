<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HashGuard.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HashGuard.App.Pages">

    <Page.Resources>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="2,20,0,6" />
        </Style>
        <Style x:Key="RowStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="20,14" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="RowTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}" />
        <Style x:Key="RowHintStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel MaxWidth="1040" Padding="32,4,32,32">
            <Grid>
                <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="{x:Bind ViewModel.SavedText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Right"
                           VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </Grid>
            <TextBlock Text="Changes are saved as you make them." Style="{StaticResource RowHintStyle}" Margin="0,4,0,0" />

            <!-- Reputation sources -->
            <TextBlock Text="Reputation sources" Style="{StaticResource SectionHeaderStyle}" AutomationProperties.HeadingLevel="Level2" />

            <Border Style="{StaticResource RowStyle}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="VirusTotal" Style="{StaticResource RowTitleStyle}" />
                            <TextBlock Text="Asks about 70 antivirus engines about each file's hash. Free keys allow 4 lookups a minute and 500 a day." Style="{StaticResource RowHintStyle}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.VirusTotalEnabled, Mode=TwoWay}" OnContent="On" OffContent="Off" MinWidth="0"
                                      AutomationProperties.Name="VirusTotal" />
                    </Grid>
                    <StackPanel Spacing="4">
                        <PasswordBox x:Name="VirusTotalKeyBox" Header="API key" PlaceholderText="Paste your VirusTotal API key" MaxWidth="520" HorizontalAlignment="Left" Width="520"
                                     PasswordRevealMode="Peek" PasswordChanged="VirusTotalKey_Changed" />
                        <TextBlock Text="{x:Bind ViewModel.VirusTotalKeyStatus, Mode=OneWay}" Style="{StaticResource RowHintStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource RowStyle}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="MetaDefender Cloud" Style="{StaticResource RowTitleStyle}" />
                            <TextBlock Text="OPSWAT's multi-engine hash lookup. Needs its own free API key." Style="{StaticResource RowHintStyle}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.MetaDefenderEnabled, Mode=TwoWay}" OnContent="On" OffContent="Off" MinWidth="0"
                                      AutomationProperties.Name="MetaDefender Cloud" />
                    </Grid>
                    <StackPanel Spacing="4">
                        <PasswordBox x:Name="MetaDefenderKeyBox" Header="API key" PlaceholderText="Paste your MetaDefender API key" HorizontalAlignment="Left" Width="520"
                                     PasswordRevealMode="Peek" PasswordChanged="MetaDefenderKey_Changed" />
                        <TextBlock Text="{x:Bind ViewModel.MetaDefenderKeyStatus, Mode=OneWay}" Style="{StaticResource RowHintStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource RowStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Team Cymru Malware Hash Registry" Style="{StaticResource RowTitleStyle}" />
                        <TextBlock Text="A free hash lookup over DNS. No key needed." Style="{StaticResource RowHintStyle}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.CymruEnabled, Mode=TwoWay}" OnContent="On" OffContent="Off" MinWidth="0"
                                  AutomationProperties.Name="Team Cymru" />
                </Grid>
            </Border>

            <Border Style="{StaticResource RowStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Offer to send unknown files to VirusTotal" Style="{StaticResource RowTitleStyle}" />
                        <TextBlock Text="Files no source knows get a &quot;Send to VirusTotal&quot; button. Nothing is uploaded until you approve that file." Style="{StaticResource RowHintStyle}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.UploadUnknown, Mode=TwoWay}" OnContent="On" OffContent="Off" MinWidth="0"
                                  AutomationProperties.Name="Offer to send unknown files to VirusTotal" />
                </Grid>
            </Border>

            <Border Style="{StaticResource RowStyle}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Keep to free API limits" Style="{StaticResource RowTitleStyle}" />
                            <TextBlock Text="Paces VirusTotal to 4 lookups a minute and 500 a day. Turn off only with a paid key." Style="{StaticResource RowHintStyle}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.FreeApiLimits, Mode=TwoWay}" OnContent="On" OffContent="Off" MinWidth="0"
                                      AutomationProperties.Name="Keep to free API limits" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <NumberBox Header="Seconds between VirusTotal lookups" Value="{x:Bind ViewModel.DelaySeconds, Mode=TwoWay}" Minimum="0" Maximum="600"
                                   SpinButtonPlacementMode="Compact" Width="250" ValueChanged="Number_Changed" />
                        <NumberBox Header="Request timeout (seconds)" Value="{x:Bind ViewModel.TimeoutSeconds, Mode=TwoWay}" Minimum="5" Maximum="600"
                                   SpinButtonPlacementMode="Compact" Width="200" ValueChanged="Number_Changed" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Scanning -->
            <TextBlock Text="Scanning" Style="{StaticResource SectionHeaderStyle}" AutomationProperties.HeadingLevel="Level2" />

            <Border Style="{StaticResource RowStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Scan running apps when HashGuard starts" Style="{StaticResource RowTitleStyle}" />
                        <TextBlock Text="After that scan, programs that start or change are checked within seconds." Style="{StaticResource RowHintStyle}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.AutoProcessScan, Mode=TwoWay}" OnContent="On" OffContent="Off" MinWidth="0"
                                  AutomationProperties.Name="Scan running apps when HashGuard starts" />
                </Grid>
            </Border>

            <Border Style="{StaticResource RowStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Scan files I open or select" Style="{StaticResource RowTitleStyle}" />
                        <TextBlock Text="Checks files you open, and files selected in File Explorer, by hash only: nothing is uploaded. Pictures, video and audio are skipped."
                                   Style="{StaticResource RowHintStyle}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="ScanAllFilesSwitch" Grid.Column="1" IsOn="{x:Bind ViewModel.ScanAllFiles, Mode=TwoWay}" OnContent="On" OffContent="Off" MinWidth="0"
                                  Toggled="ScanAllFiles_Toggled" AutomationProperties.Name="Scan files I open or select" />
                </Grid>
            </Border>

            <Border Style="{StaticResource RowStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Remember results (hash cache)" Style="{StaticResource RowTitleStyle}" />
                        <TextBlock Text="Reuses earlier answers for files already checked, so scans are faster and use fewer lookups." Style="{StaticResource RowHintStyle}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.HashCacheEnabled, Mode=TwoWay}" OnContent="On" OffContent="Off" MinWidth="0"
                                  AutomationProperties.Name="Remember results" />
                </Grid>
            </Border>

            <Border Style="{StaticResource RowStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Skip re-hashing unchanged files" Style="{StaticResource RowTitleStyle}" />
                        <TextBlock Text="Files whose size and date haven't changed since the last check aren't read again. Faster; needs the hash cache." Style="{StaticResource RowHintStyle}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.DeltaScanEnabled, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.HashCacheEnabled, Mode=OneWay}"
                                  OnContent="On" OffContent="Off" MinWidth="0" AutomationProperties.Name="Skip re-hashing unchanged files" />
                </Grid>
            </Border>

            <!-- Firewall -->
            <TextBlock Text="Firewall" Style="{StaticResource SectionHeaderStyle}" AutomationProperties.HeadingLevel="Level2" />

            <Border Style="{StaticResource RowStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Watch network connections in the background" Style="{StaticResource RowTitleStyle}" />
                        <TextBlock Text="Needed for new-program alerts and automatic blocking. Off: HashGuard watches only while the Firewall page is open." Style="{StaticResource RowHintStyle}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.NetworkMonitorEnabled, Mode=TwoWay}" OnContent="On" OffContent="Off" MinWidth="0"
                                  AutomationProperties.Name="Watch network connections in the background" />
                </Grid>
            </Border>

            <Border Style="{StaticResource RowStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Tell me when a program goes online for the first time" Style="{StaticResource RowTitleStyle}" />
                        <TextBlock Text="Programs already online when watching started are recorded quietly." Style="{StaticResource RowHintStyle}" />
                    </StackPanel>
                    <ComboBox Grid.Column="1" SelectedIndex="{x:Bind ViewModel.NotifyModeIndex, Mode=TwoWay}" MinWidth="220" VerticalAlignment="Center"
                              IsEnabled="{x:Bind ViewModel.NetworkMonitorEnabled, Mode=OneWay}" AutomationProperties.Name="New program alerts">
                        <ComboBoxItem Content="Only programs I don't trust" />
                        <ComboBoxItem Content="Every new program" />
                        <ComboBoxItem Content="Never" />
                    </ComboBox>
                </Grid>
            </Border>

            <Border Style="{StaticResource RowStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Block programs flagged as malicious automatically" Style="{StaticResource RowTitleStyle}" />
                        <TextBlock Text="As soon as a program a scan flagged as malicious connects, HashGuard blocks it in Windows Firewall. A program you unblock stays allowed until the file changes. Needs HashGuard to run as administrator."
                                   Style="{StaticResource RowHintStyle}" />
                        <TextBlock Text="Paused: this copy isn't running as administrator." Style="{StaticResource RowHintStyle}" Foreground="{ThemeResource AttentionTextBrush}"
                                   Visibility="{x:Bind local:SettingsPage.VisibleWhenNot(ViewModel.IsElevated)}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.AutoBlockMalicious, Mode=TwoWay}" OnContent="On" OffContent="Off" MinWidth="0"
                                  IsEnabled="{x:Bind ViewModel.NetworkMonitorEnabled, Mode=OneWay}" AutomationProperties.Name="Block programs flagged as malicious automatically" />
                </Grid>
            </Border>

            <!-- Trusted publishers -->
            <TextBlock Text="Trusted publishers" Style="{StaticResource SectionHeaderStyle}" AutomationProperties.HeadingLevel="Level2" />
            <Border Style="{StaticResource RowStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Files with a valid signature from these exact names get a lower risk score." Style="{StaticResource RowHintStyle}" />
                    <Grid ColumnSpacing="8" MaxWidth="520" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{x:Bind ViewModel.NewPublisher, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Publisher name, as shown in a file's signature"
                                 Width="400" KeyDown="NewPublisher_KeyDown" AutomationProperties.Name="New trusted publisher" />
                        <Button Grid.Column="1" Content="Add" Click="AddPublisher_Click" />
                    </Grid>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.TrustedPublishers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Grid ColumnSpacing="8" Padding="0,2" MaxWidth="520" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="400" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Button Grid.Column="1" Tag="{x:Bind}" Click="RemovePublisher_Click" AutomationProperties.Name="Remove publisher" ToolTipService.ToolTip="Remove">
                                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Ignored -->
            <TextBlock Text="Ignored files and locations" Style="{StaticResource SectionHeaderStyle}" AutomationProperties.HeadingLevel="Level2" />
            <Border Style="{StaticResource RowStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Nothing is ignored. When you ignore a file or a location from a scan, it's listed here." Style="{StaticResource RowHintStyle}"
                               Visibility="{x:Bind local:SettingsPage.VisibleWhenNot(ViewModel.HasIgnored), Mode=OneWay}" />
                    <TextBlock Text="Locations" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold"
                               Visibility="{x:Bind local:SettingsPage.VisibleWhenAny(ViewModel.IgnoredPaths.Count), Mode=OneWay}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.IgnoredPaths}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Grid ColumnSpacing="8" Padding="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                                    <Button Grid.Column="1" Content="Stop ignoring" Tag="{x:Bind}" Click="RemoveIgnoredPath_Click" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Files (by SHA-256)" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold"
                               Visibility="{x:Bind local:SettingsPage.VisibleWhenAny(ViewModel.IgnoredHashes.Count), Mode=OneWay}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.IgnoredHashes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Grid ColumnSpacing="8" Padding="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind}" VerticalAlignment="Center" FontFamily="Consolas" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                                    <Button Grid.Column="1" Content="Stop ignoring" Tag="{x:Bind}" Click="RemoveIgnoredHash_Click" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Windows -->
            <TextBlock Text="Windows" Style="{StaticResource SectionHeaderStyle}" AutomationProperties.HeadingLevel="Level2" />
            <TextBlock Text="These change Windows itself, straight away. A setting another copy of HashGuard manages (for example HashGuard 1.x) is shown here but changed there."
                       Style="{StaticResource RowHintStyle}" Margin="2,0,0,8" />

            <Border Style="{StaticResource RowStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Start HashGuard when I sign in" Style="{StaticResource RowTitleStyle}" />
                        <TextBlock Text="Starts in the tray." Style="{StaticResource RowHintStyle}" />
                        <TextBlock Text="{x:Bind local:SettingsPage.OwnerText(ViewModel.StartupOwner), Mode=OneWay}" Style="{StaticResource RowHintStyle}"
                                   Foreground="{ThemeResource AttentionTextBrush}" Visibility="{x:Bind local:SettingsPage.VisibleWhenText(ViewModel.StartupOwner), Mode=OneWay}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="StartWithWindowsSwitch" Grid.Column="1" IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanChangeStartup, Mode=OneWay}"
                                  Toggled="StartWithWindows_Toggled" OnContent="On" OffContent="Off" MinWidth="0" AutomationProperties.Name="Start HashGuard when I sign in" />
                </Grid>
            </Border>

            <Border Style="{StaticResource RowStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Start in the tray when I open it" Style="{StaticResource RowTitleStyle}" />
                        <TextBlock Text="Opening HashGuard puts it in the tray without showing the window." Style="{StaticResource RowHintStyle}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.StartMinimized, Mode=TwoWay}" OnContent="On" OffContent="Off" MinWidth="0"
                                  AutomationProperties.Name="Start in the tray" />
                </Grid>
            </Border>

            <Border Style="{StaticResource RowStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Run as administrator" Style="{StaticResource RowTitleStyle}" />
                        <TextBlock Text="Needed to block programs in Windows Firewall and to scan protected programs. HashGuard asks for permission when it starts; with start at sign-in, it then starts as administrator without asking."
                                   Style="{StaticResource RowHintStyle}" />
                        <TextBlock Text="Takes effect the next time HashGuard starts." Style="{StaticResource RowHintStyle}"
                                   Visibility="{x:Bind local:SettingsPage.RestartNote(ViewModel.RunElevated, ViewModel.IsElevated), Mode=OneWay}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="RunElevatedSwitch" Grid.Column="1" IsOn="{x:Bind ViewModel.RunElevated, Mode=TwoWay}" Toggled="RunElevated_Toggled"
                                  OnContent="On" OffContent="Off" MinWidth="0" AutomationProperties.Name="Run as administrator" />
                </Grid>
            </Border>

            <Border Style="{StaticResource RowStyle}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Daily scan" Style="{StaticResource RowTitleStyle}" />
                            <TextBlock Text="Scans running apps once a day, quietly. If the PC is off at that hour, it scans as soon as it can." Style="{StaticResource RowHintStyle}" />
                            <TextBlock Text="{x:Bind local:SettingsPage.OwnerText(ViewModel.DailyScanOwner), Mode=OneWay}" Style="{StaticResource RowHintStyle}"
                                       Foreground="{ThemeResource AttentionTextBrush}" Visibility="{x:Bind local:SettingsPage.VisibleWhenText(ViewModel.DailyScanOwner), Mode=OneWay}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="DailyScanSwitch" Grid.Column="1" IsOn="{x:Bind ViewModel.DailyScan, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanChangeDailyScan, Mode=OneWay}"
                                      Toggled="DailyScan_Toggled" OnContent="On" OffContent="Off" MinWidth="0" AutomationProperties.Name="Daily scan" />
                    </Grid>
                    <ComboBox x:Name="DailyHourBox" Header="Time" ItemsSource="{x:Bind local:SettingsPage.DailyScanTimes}" Width="220"
                              SelectedIndex="{x:Bind local:SettingsPage.HourIndex(ViewModel.DailyScanHour), Mode=OneWay}"
                              HorizontalAlignment="Left" IsEnabled="{x:Bind ViewModel.CanChangeDailyScan, Mode=OneWay}" SelectionChanged="DailyHour_Changed"
                              AutomationProperties.Name="Daily scan time" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource RowStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="&quot;Scan with HashGuard&quot; in File Explorer" Style="{StaticResource RowTitleStyle}" />
                        <TextBlock Text="Adds the command to a file's right-click menu (under Show more options on Windows 11), for your account only." Style="{StaticResource RowHintStyle}" />
                        <TextBlock Text="{x:Bind local:SettingsPage.OwnerText(ViewModel.RightClickOwner), Mode=OneWay}" Style="{StaticResource RowHintStyle}"
                                   Foreground="{ThemeResource AttentionTextBrush}" Visibility="{x:Bind local:SettingsPage.VisibleWhenText(ViewModel.RightClickOwner), Mode=OneWay}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="RightClickSwitch" Grid.Column="1" IsOn="{x:Bind ViewModel.RightClickMenu, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanChangeRightClick, Mode=OneWay}"
                                  Toggled="RightClick_Toggled" OnContent="On" OffContent="Off" MinWidth="0" AutomationProperties.Name="Scan with HashGuard in File Explorer" />
                </Grid>
            </Border>

            <!-- Updates -->
            <TextBlock Text="Updates" Style="{StaticResource SectionHeaderStyle}" AutomationProperties.HeadingLevel="Level2" />
            <Border Style="{StaticResource RowStyle}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.VersionText}" Style="{StaticResource RowTitleStyle}" />
                            <TextBlock Text="Updates come from HashGuard's GitHub releases and are installed only if their checksum and release signature check out."
                                       Style="{StaticResource RowHintStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.UpdateStatus, Mode=OneWay}" Style="{StaticResource RowHintStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.UpdateBusy, Mode=OneWay}" />
                            <Button Content="Install update" Style="{StaticResource AccentButtonStyle}" Click="InstallUpdate_Click"
                                    Visibility="{x:Bind ViewModel.HasOffer, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanCheck, Mode=OneWay}" />
                            <Button Content="Check now" Click="CheckUpdates_Click" IsEnabled="{x:Bind ViewModel.CanCheck, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Check for updates automatically" Style="{StaticResource RowTitleStyle}" VerticalAlignment="Center" />
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.AutoUpdateChecks, Mode=TwoWay}" OnContent="On" OffContent="Off" MinWidth="0"
                                      AutomationProperties.Name="Check for updates automatically" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Appearance -->
            <TextBlock Text="Appearance" Style="{StaticResource SectionHeaderStyle}" AutomationProperties.HeadingLevel="Level2" />
            <Border Style="{StaticResource RowStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Theme" Style="{StaticResource RowTitleStyle}" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}" MinWidth="180" AutomationProperties.Name="Theme">
                        <ComboBoxItem Content="Use Windows setting" />
                        <ComboBoxItem Content="Light" />
                        <ComboBoxItem Content="Dark" />
                    </ComboBox>
                </Grid>
            </Border>

            <!-- Later -->
            <TextBlock Text="Coming in later previews" Style="{StaticResource SectionHeaderStyle}" AutomationProperties.HeadingLevel="Level2" />
            <Border Style="{StaticResource RowStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Style="{StaticResource RowHintStyle}"
                               Text="Usage data. Until then its setting is left as it is." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
