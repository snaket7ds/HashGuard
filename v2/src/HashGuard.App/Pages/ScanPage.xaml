<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HashGuard.App.Pages.ScanPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:HashGuard.App.ViewModels"
    xmlns:local="using:HashGuard.App.Pages"
    NavigationCacheMode="Required">

    <Grid MaxWidth="1040" Padding="32,4,32,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Scan" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,4" />

        <!-- What to scan, and the Scan button. -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="24,20">
            <StackPanel Spacing="16">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <RadioButton x:Name="RunningAppsChoice" GroupName="ScanKind" IsChecked="True" HorizontalAlignment="Stretch"
                                 Checked="RunningAppsChoice_Checked" AutomationProperties.Name="Running apps">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Running apps" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Every app running now, and everything that starts with Windows."
                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </RadioButton>
                    <Grid Grid.Column="1" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <RadioButton x:Name="FilesChoice" GroupName="ScanKind" HorizontalAlignment="Stretch"
                                     IsChecked="{x:Bind ViewModel.ScanFilesMode, Mode=TwoWay}" AutomationProperties.Name="Chosen files">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Chosen files" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.ChosenFilesText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </RadioButton>
                        <Button Grid.Column="1" Content="Choose…" VerticalAlignment="Center" Click="ChooseFiles_Click" IsEnabled="{x:Bind local:ScanPage.Not(ViewModel.IsScanning), Mode=OneWay}" />
                    </Grid>
                </Grid>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ScanButton" Style="{StaticResource AccentButtonStyle}" Padding="20,9" MinWidth="120"
                            Click="Scan_Click" IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind ViewModel.ScanButtonText, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="{x:Bind ViewModel.ScanButtonGlyph, Mode=OneWay}" FontSize="14" />
                            <TextBlock Text="{x:Bind ViewModel.ScanButtonText, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                        <ProgressBar Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay}" IsIndeterminate="{x:Bind ViewModel.ProgressIndeterminate, Mode=OneWay}"
                                     Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}" Maximum="{x:Bind ViewModel.ProgressMax, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"
                                   Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="WrapWholeWords"
                                   Visibility="{x:Bind local:ScanPage.VisibleWhenNot(ViewModel.IsScanning), Mode=OneWay}" />
                    </StackPanel>
                </Grid>

                <!-- Which sources this scan asks. -->
                <ItemsControl ItemsSource="{x:Bind ViewModel.Sources, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SourceChip">
                            <Border Style="{StaticResource ChipStyle}" Background="{x:Bind local:ScanPage.ChipBackground(IsOn)}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{x:Bind local:ScanPage.ChipForeground(IsOn)}" />
                                    <TextBlock Text="{x:Bind Text}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{x:Bind local:ScanPage.ChipForeground(IsOn)}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <InfoBar Severity="Informational" IsOpen="{x:Bind local:ScanPage.HasText(ViewModel.KeyWarning), Mode=OneWay}" IsClosable="False"
                         Message="{x:Bind ViewModel.KeyWarning, Mode=OneWay}" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
            <TextBlock Text="Needs your decision" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18" AutomationProperties.HeadingLevel="Level2" />
            <Border Style="{StaticResource ChipStyle}" VerticalAlignment="Center" Background="{x:Bind local:ScanPage.CountBackground(ViewModel.HasFindings), Mode=OneWay}">
                <TextBlock Text="{x:Bind ViewModel.DecisionCount, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold"
                           Foreground="{x:Bind local:ScanPage.CountForeground(ViewModel.HasFindings), Mode=OneWay}" />
            </Border>
        </StackPanel>

        <Grid Grid.Row="3">
            <!-- Empty state. -->
            <Border Style="{StaticResource CardStyle}" VerticalAlignment="Top" Padding="24,20"
                    Visibility="{x:Bind local:ScanPage.VisibleWhenNot(ViewModel.HasFindings), Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE73E;" Foreground="{ThemeResource GoodTextBrush}" />
                    <TextBlock Text="Nothing needs your decision." Style="{StaticResource BodyTextBlockStyle}" />
                </StackPanel>
            </Border>

            <ListView ItemsSource="{x:Bind ViewModel.Findings}" SelectionMode="None" Padding="0" IsItemClickEnabled="False"
                      Visibility="{x:Bind ViewModel.HasFindings, Mode=OneWay}" AutomationProperties.Name="Needs your decision">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:FindingViewModel">
                        <Border Style="{StaticResource CardStyle}" Padding="16,14">
                            <Grid ColumnSpacing="14" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Width="36" Height="36" CornerRadius="8" VerticalAlignment="Top" Background="{x:Bind local:ScanPage.KindTint(Kind), Mode=OneWay}">
                                    <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="16" Foreground="{x:Bind local:ScanPage.KindText(Kind), Mode=OneWay}" />
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                        <Border Style="{StaticResource ChipStyle}" Padding="8,1" Background="{x:Bind local:ScanPage.KindTint(Kind), Mode=OneWay}">
                                            <TextBlock Text="{x:Bind Pill, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{x:Bind local:ScanPage.KindText(Kind), Mode=OneWay}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind PathText}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <ProgressRing Width="20" Height="20" IsActive="{x:Bind IsBusy, Mode=OneWay}" Visibility="{x:Bind IsBusy, Mode=OneWay}" />
                                    <ToggleButton Content="Details" IsChecked="{x:Bind IsExpanded, Mode=TwoWay}" />
                                    <DropDownButton Content="Ignore" IsEnabled="{x:Bind local:ScanPage.Not(IsBusy), Mode=OneWay}">
                                        <DropDownButton.Flyout>
                                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                <MenuFlyoutItem Text="Ignore this file" Tag="{x:Bind Self}" Click="IgnoreHash_Click">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A5;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="Ignore anything at this location" Tag="{x:Bind Self}" Click="IgnorePath_Click">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </DropDownButton.Flyout>
                                    </DropDownButton>
                                    <Button Content="Send to VirusTotal" Tag="{x:Bind Self}" Click="SendToVirusTotal_Click"
                                            Visibility="{x:Bind CanSendToVirusTotal, Mode=OneWay}" IsEnabled="{x:Bind local:ScanPage.Not(IsBusy), Mode=OneWay}" />
                                </StackPanel>

                                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{x:Bind DetailText, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" IsTextSelectionEnabled="True" Visibility="{x:Bind IsExpanded, Mode=OneWay}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
