<?xml version="1.0" encoding="utf-8"?>
<!--
    HashGuard v2 theme: stock Fluent controls, HashGuard's shield green as the accent,
    and four status tones (good, attention, danger, neutral) carried over from v1's palette.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="GoodTextBrush" Color="#116236" />
            <SolidColorBrush x:Key="GoodTintBrush" Color="#E6F4EA" />
            <SolidColorBrush x:Key="AttentionTextBrush" Color="#7A4F00" />
            <SolidColorBrush x:Key="AttentionTintBrush" Color="#FFF1D6" />
            <SolidColorBrush x:Key="DangerTextBrush" Color="#B42318" />
            <SolidColorBrush x:Key="DangerTintBrush" Color="#FEE4E2" />
            <SolidColorBrush x:Key="NeutralTextBrush" Color="#5B6472" />
            <SolidColorBrush x:Key="NeutralTintBrush" Color="#EEF0F3" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="GoodTextBrush" Color="#9BDD55" />
            <SolidColorBrush x:Key="GoodTintBrush" Color="#22301A" />
            <SolidColorBrush x:Key="AttentionTextBrush" Color="#F2C066" />
            <SolidColorBrush x:Key="AttentionTintBrush" Color="#3A2E14" />
            <SolidColorBrush x:Key="DangerTextBrush" Color="#FF7A73" />
            <SolidColorBrush x:Key="DangerTintBrush" Color="#3A1D1C" />
            <SolidColorBrush x:Key="NeutralTextBrush" Color="#A6B0AB" />
            <SolidColorBrush x:Key="NeutralTintBrush" Color="#2A2F2D" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="GoodTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="GoodTintBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="AttentionTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="AttentionTintBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="DangerTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DangerTintBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="NeutralTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="NeutralTintBrush" Color="{ThemeResource SystemColorWindowColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Shield green #18864A and its ramp. -->
    <Color x:Key="SystemAccentColor">#18864A</Color>
    <Color x:Key="SystemAccentColorDark1">#146F3D</Color>
    <Color x:Key="SystemAccentColorDark2">#0F5A31</Color>
    <Color x:Key="SystemAccentColorDark3">#0A4524</Color>
    <Color x:Key="SystemAccentColorLight1">#2FA061</Color>
    <Color x:Key="SystemAccentColorLight2">#5BBB82</Color>
    <Color x:Key="SystemAccentColorLight3">#8ED3A8</Color>


    <!-- A card: the Fluent layer surface with a hairline border. -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <!-- A chip: small rounded label. -->
    <Style x:Key="ChipStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="10,4,12,4" />
        <Setter Property="Background" Value="{ThemeResource NeutralTintBrush}" />
    </Style>

    <Style x:Key="FactLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="FactValueStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
</ResourceDictionary>
